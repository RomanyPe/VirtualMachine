// sys.asm – System information and control

func_set_int_table_base:
    MOV rTB, r0
    RET


// -------------------------------------------------------------------
// Читает значение любого регистра по индексу (0..31)
// Вход: r0 = номер регистра (см. RegType)
// Возврат: r0 = значение регистра
// Примечание: rZ всегда вернёт 0
// -------------------------------------------------------------------
func_read_register:
    // Используем серию проверок и переходов
    // т.к. нет косвенной адресации регистров, применяем switch
    // Здесь приведены только несколько примеров, 
    // при необходимости дополните для всех 32 регистров
    LDI r1, 0
    CALL func_cmp_equal
    JZ r0_is_0

    LDI r1, 1
    CALL func_cmp_equal
    JZ r0_is_1

    LDI r1, 2
    CALL func_cmp_equal
    JZ r0_is_2

    LDI r1, 3
    CALL func_cmp_equal
    JZ r0_is_3

    LDI r1, 4
    CALL func_cmp_equal
    JZ r0_is_4

    LDI r1, 5
    CALL func_cmp_equal
    JZ r0_is_5

    LDI r1, 6
    CALL func_cmp_equal
    JZ r0_is_6

    LDI r1, 7
    CALL func_cmp_equal
    JZ r0_is_7

    LDI r1, 8
    CALL func_cmp_equal
    JZ r0_is_8

    LDI r1, 9
    CALL func_cmp_equal
    JZ r0_is_9

    LDI r1, 10
    CALL func_cmp_equal
    JZ r0_is_10

    LDI r1, 11
    CALL func_cmp_equal
    JZ r0_is_11

    LDI r1, 12
    CALL func_cmp_equal
    JZ r0_is_12

    LDI r1, 13
    CALL func_cmp_equal
    JZ r0_is_13

    LDI r1, 14
    CALL func_cmp_equal
    JZ r0_is_14

    LDI r1, 15
    CALL func_cmp_equal
    JZ r0_is_15

    LDI r1, 16
    CALL func_cmp_equal
    JZ r0_is_16

    LDI r1, 17
    CALL func_cmp_equal
    JZ r0_is_17

    LDI r1, 18
    CALL func_cmp_equal
    JZ r0_is_18

    LDI r1, 19
    CALL func_cmp_equal
    JZ r0_is_19

    LDI r1, 20
    CALL func_cmp_equal
    JZ r0_is_20

    LDI r1, 21
    CALL func_cmp_equal
    JZ r0_is_21

    LDI r1, 22
    CALL func_cmp_equal
    JZ r0_is_r22

    LDI r1, 23
    CALL func_cmp_equal
    JZ r0_is_r23

    LDI r1, 24
    CALL func_cmp_equal
    JZ r0_is_rTB

    LDI r1, 25
    CALL func_cmp_equal
    JZ r0_is_rCD

    LDI r1, 26
    CALL func_cmp_equal
    JZ r0_is_rFL

    LDI r1, 27
    CALL func_cmp_equal
    JZ r0_is_rCL

    LDI r1, 28
    CALL func_cmp_equal
    JZ r0_is_rSP

    LDI r1, 29
    CALL func_cmp_equal
    JZ r0_is_rHP

    LDI r1, 30
    CALL func_cmp_equal
    JZ r0_is_rIP

    // fallback – неверный номер
    LDI r0, 0
    RET

r0_is_0:
    MOV r0, r0
    RET
r0_is_1:
    MOV r0, r1
    RET
r0_is_2:
    MOV r0, r2
    RET
r0_is_3:
    MOV r0, r3
    RET
r0_is_4:
    MOV r0, r4
    RET
r0_is_5:
    MOV r0, r5
    RET
r0_is_6:
    MOV r0, r6
    RET
r0_is_7:
    MOV r0, r7
    RET
r0_is_8:
    MOV r0, r8
    RET
r0_is_9:
    MOV r0, r9
    RET
r0_is_10:
    MOV r0, r10
    RET
r0_is_11:
    MOV r0, r11
    RET
r0_is_12:
    MOV r0, r12
    RET
r0_is_13:
    MOV r0, r13
    RET
r0_is_14:
    MOV r0, r14
    RET
r0_is_15:
    MOV r0, r15
    RET
r0_is_16:
    MOV r0, r16
    RET
r0_is_17:
    MOV r0, r17
    RET
r0_is_18:
    MOV r0, r18
    RET
r0_is_19:
    MOV r0, r19
    RET
r0_is_20:
    MOV r0, r20
    RET
r0_is_21:
    MOV r0, r21
    RET
r0_is_r22:    
    MOV r0, r22
    RET
r0_is_r23:    MOV r0, r23
              RET
r0_is_rTB:    MOV r0, rTB
              RET
r0_is_rCD:    MOV r0, rCD
              RET
r0_is_rFL:    MOV r0, rFL
              RET
r0_is_rCL:    MOV r0, rCL
              RET
r0_is_rSP:    MOV r0, rSP
              RET
r0_is_rHP:    MOV r0, rHP
              RET
r0_is_rIP:    MOV r0, rIP
              RET



// -------------------------------------------------------------------
// Возвращает текущий адрес начала кучи (конец программы)
// -------------------------------------------------------------------
func_get_program_end:
    MOV r0, rHP
    RET


// -------------------------------------------------------------------
// Вспомогательная функция: сравнивает r0 с r1 (регистр с константой)
// Устанавливает флаги (Zero) для последующего JZ/JZ
// -------------------------------------------------------------------
func_cmp_equal:
    SUB r1, r0      // r1 = r1 - r0, флаги обновляются
    RET

// -------------------------------------------------------------------
// Возвращает адрес начала программы (константа 0x0 или другое соглашение)
// -------------------------------------------------------------------
func_get_program_start:
    LDI r0, 0x0     // у вас BaseAdressProgramm = 0x0
    RET

// -------------------------------------------------------------------
// Возвращает текущий указатель стека
// -------------------------------------------------------------------
func_get_stack_ptr:
    MOV r0, rSP
    RET

// -------------------------------------------------------------------
// Отладочный вывод целого числа (альтернатива PRINT_INT без прерываний)
// Просто вызывает PRINT_INT, оставлено для совместимости
// -------------------------------------------------------------------
func_debug_print_int:
    PRINT_INT r0
    RET

// -------------------------------------------------------------------
// Установка нового значения rHP (опасно, используйте осторожно)
// Вход: r0 = новое значение rHP
// -------------------------------------------------------------------
func_set_heap_ptr:
    MOV rHP, r0
    RET